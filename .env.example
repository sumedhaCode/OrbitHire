# Copy to .env.local
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/orbithire?retryWrites=true&w=majority
# Local Docker: mongodb://127.0.0.1:27017/orbithire
# If unset, OrbitHire starts an in-memory MongoDB (fine for demos).
MONGODB_URI=
SESSION_SECRET=replace-with-a-long-random-string
